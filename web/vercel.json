{
  "cleanUrls": true,
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
    ] },
    { "source": "/sign", "headers": [ { "key": "X-Robots-Tag", "value": "noindex" } ] },
    { "source": "/gen.wasm", "headers": [ { "key": "Content-Type", "value": "application/wasm" } ] }
  ]
}
